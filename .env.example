APP_NAME="Ingenio SEO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=idseo
DB_USERNAME=idseo
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3/
DATAFORSEO_TIMEOUT=30
DATAFORSEO_RATE_LIMIT_PER_MINUTE=1500
DATAFORSEO_MAX_TASKS_PER_REQUEST=100
DATAFORSEO_SEARCH_VOLUME_LIVE_COST_ESTIMATE=
DATAFORSEO_RANK_TRACKING_STANDARD_COST_ESTIMATE_PER_KEYWORD=
DATAFORSEO_KEYWORD_IDEAS_LIVE_COST_ESTIMATE=
DATAFORSEO_BACKLINK_PROFILE_LIVE_COST_ESTIMATE=
DATAFORSEO_BACKLINK_COMPARISON_LIVE_COST_ESTIMATE=
DATAFORSEO_ONPAGE_AUDIT_COST_PER_PAGE_ESTIMATE=
DATAFORSEO_ONPAGE_AUDIT_DEFAULT_MAX_CRAWL_PAGES=100
DATAFORSEO_ONPAGE_PAGES_FETCH_LIMIT=1000
DATAFORSEO_BUSINESS_REVIEWS_COST_PER_10_ESTIMATE=
DATAFORSEO_BUSINESS_REVIEWS_DEFAULT_DEPTH=20
DATAFORSEO_LLM_MENTIONS_SEARCH_LIVE_COST_ESTIMATE=

DATAFORSEO_WEBHOOK_TOKEN=
DATAFORSEO_RECONCILE_PENDING_AFTER_HOURS=6

ALERTS_POSITION_DROP_THRESHOLD=5

BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_TIMEOUT=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# En producción debe ser un disco externo (ej. "s3"), nunca "local"
# (sección 9 del SPEC: respaldos a almacenamiento externo).
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

COST_CONTROL_PAID_ACTION_MAX_ATTEMPTS=5
COST_CONTROL_PAID_ACTION_DECAY_SECONDS=60

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI="${APP_URL}/admin/gsc/callback"

VITE_APP_NAME="${APP_NAME}"

# Monitoreo de excepciones (sección 12 del SPEC). Sin DSN, el SDK no
# manda nada — seguro dejarlo vacío en desarrollo. Crear un proyecto
# gratuito en sentry.io y pegar su DSN aquí antes de producción.
SENTRY_LARAVEL_DSN=
# Muestreo de trazas de performance (APM), no de excepciones — esas
# siempre se reportan si hay DSN. 0 = solo excepciones, sin overhead
# de tracing. Subir con cuidado: cuenta contra la cuota del plan.
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT="${APP_ENV}"
